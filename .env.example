# Copy to .env and fill in. The app refuses to boot if any required value is
# missing or malformed — see src/config/env.validation.ts.

NODE_ENV=development
PORT=3000

# Must match docker-compose.yml for local development.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=banking
DATABASE_PASSWORD=change_me
DATABASE_NAME=banking

REDIS_HOST=localhost
REDIS_PORT=6379

# Minimum 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_openssl_rand_hex_32_output_min_32_chars

# Core-banking middleware. Points at the built-in mock in development.
MIDDLEWARE_URL=http://localhost:3000/api/v1
