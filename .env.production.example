# Copy to .env.production ON THE SERVER and fill in. Never commit the result.
#
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#
# docker-compose.prod.yml reads this file. The app refuses to boot if anything
# here is missing or malformed — see src/config/env.validation.ts.

NODE_ENV=production
# Leave at 3000 — docker-compose.prod.yml maps and health-checks that port.
PORT=3000

# Service names from docker-compose.prod.yml, NOT localhost: inside a container
# localhost is that container itself. Point these at a managed database or
# cache instead if you are not running them in compose.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USER=banking
DATABASE_NAME=banking
# Generate with: openssl rand -base64 24
DATABASE_PASSWORD=

# The postgres image reads these three to create the database on first boot.
# They MUST match the DATABASE_* values above — the API connects with those.
# Ignore them if you use a managed database instead of the compose service.
POSTGRES_USER=banking
POSTGRES_DB=banking
POSTGRES_PASSWORD=

REDIS_HOST=redis
REDIS_PORT=6379

# Minimum 32 characters. Generate with: openssl rand -hex 32
# Rotating this logs every customer out — refresh tokens are signed with it too.
JWT_SECRET=

# The bank's real middleware. The bundled mock does NOT ship in a production
# image (see app.module.ts), so a wrong value here means every balance read
# fails with MIDDLEWARE_UNAVAILABLE.
MIDDLEWARE_URL=https://middleware.yourbank.example/api/v1

# Browser front-ends allowed to call this API, comma-separated. Leave empty if
# only mobile apps call it — native apps send no Origin header, so CORS does
# not apply to them.
CORS_ORIGINS=https://app.yourbank.example

# Reverse-proxy hops in front of the app. 1 behind a single nginx/Caddy, 0 if
# the container is exposed directly. Too high and callers can spoof their IP
# past the rate limiter; too low and every customer shares one rate-limit
# bucket.
TRUST_PROXY=1
